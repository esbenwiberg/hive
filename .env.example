# Database
DATABASE_URL=postgresql://hive:hive@localhost:5432/hive

# Test database (must be localhost — tests refuse to run against remote DBs)
TEST_DATABASE_URL=postgresql://hive:hive@localhost:5432/hive_test

# Session
SESSION_SECRET=change-me-in-production

# Azure Entra ID (required for authentication)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
REDIRECT_URI=http://localhost:3000/auth/callback

# Azure Key Vault (omit for in-memory fallback in dev)
AZURE_KEYVAULT_URI=

# Anthropic
ANTHROPIC_API_KEY=

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Daemon (set HIVE_MODE=daemon to start background workers)
HIVE_MODE=
HIVE_MAX_WORKERS=5
HIVE_POLL_MS=5000
HIVE_PRODUCER_INTERVAL_MS=900000
HIVE_WORKTREE_DIR=/repos
HIVE_DAEMON_USER_ID=1
HIVE_DEFAULT_REPO_ID=
